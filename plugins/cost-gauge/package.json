{
  "name": "@dsh-local/cost-gauge",
  "version": "0.1.0",
  "description": "A clock-style gauge in the Web header showing live DeepSeek API spend (session-scoped)",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
